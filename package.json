{
  "name": "route-analyser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --configLoader runner",
    "typecheck": "tsc --noEmit",
